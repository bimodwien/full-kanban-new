# Development Environment (Database di Docker, App lokal)
# Copy ke .env untuk development

# Database Configuration
MYSQL_ROOT_PASSWORD=bimobimo
MYSQL_DATABASE=kanban

# API Configuration (localhost karena database di Docker port 3308)
DATABASE_URL=mysql://root:bimobimo@localhost:3308/kanban
JWT_SECRET=dev_secret
BCRYPT_SALT=10

# Web Configuration (API lokal port 3001)
NEXT_PUBLIC_API_URL=http://localhost:3001